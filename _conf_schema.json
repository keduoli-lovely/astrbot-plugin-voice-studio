{
  "ttsProvider": {
    "description": "当前使用的 TTS 提供商",
    "type": "string",
    "default": "indextts",
    "options": ["indextts", "gptsovits", "siliconflow", "minimax", "mimo", "openai"],
    "labels": ["IndexTTS（本地）", "GPT-SoVITS（本地）", "SiliconFlow", "MiniMax", "小米 MiMo", "OpenAI 兼容"],
    "hint": "本地提供商（indextts/gptsovits）需要先导入参考音色；在线提供商需要 apiKey。"
  },
  "indextts": {
    "description": "IndexTTS（本地 Gradio 应用）",
    "type": "object",
    "hint": "需要启动 IndexTTS 2.x 的 Gradio WebUI；插件走 /gradio_api/upload + /gradio_api/call/gen_single。",
    "items": {
      "baseUrl": {
        "description": "IndexTTS Gradio 地址",
        "type": "string",
        "default": "http://127.0.0.1:7860"
      },
      "lang": {
        "description": "语言",
        "type": "string",
        "default": "ZH",
        "options": ["ZH", "EN", "JA", "AR", "ES"]
      },
      "emoWeight": {
        "description": "情感权重",
        "type": "float",
        "default": 0.8,
        "slider": { "min": 0, "max": 1, "step": 0.05 }
      },
      "durationFactor": {
        "description": "时长系数",
        "type": "float",
        "default": 1.0,
        "slider": { "min": 0.5, "max": 2, "step": 0.05 }
      }
    }
  },
  "gptsovits": {
    "description": "GPT-SoVITS（本地 api_v2.py）",
    "type": "object",
    "hint": "baseUrl 指向 api_v2.py（默认 9880），不是 WebUI 端口。",
    "items": {
      "baseUrl": {
        "description": "GPT-SoVITS api_v2 地址",
        "type": "string",
        "default": "http://127.0.0.1:9880"
      },
      "textLang": {
        "description": "目标文本语言",
        "type": "string",
        "default": "zh"
      },
      "promptText": {
        "description": "参考音频对应的原文（留空则 ref_free=true）",
        "type": "string",
        "default": ""
      },
      "promptLang": {
        "description": "参考音频语言",
        "type": "string",
        "default": "zh"
      },
      "speed": {
        "description": "语速倍率",
        "type": "float",
        "default": 1.0,
        "slider": { "min": 0.5, "max": 2, "step": 0.05 }
      }
    }
  },
  "siliconflow": {
    "description": "硅基流动 SiliconFlow",
    "type": "object",
    "items": {
      "baseUrl": {
        "description": "API Base URL",
        "type": "string",
        "default": "https://api.siliconflow.cn/v1"
      },
      "apiKey": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true
      },
      "model": {
        "description": "模型",
        "type": "string",
        "default": "FunAudioLLM/CosyVoice2-0.5B"
      },
      "voice": {
        "description": "音色 id",
        "type": "string",
        "default": "speech:auto"
      },
      "format": {
        "description": "输出格式",
        "type": "string",
        "default": "wav",
        "options": ["wav", "mp3", "opus", "flac", "aac", "pcm"]
      }
    }
  },
  "minimax": {
    "description": "MiniMax 语音合成",
    "type": "object",
    "items": {
      "baseUrl": {
        "description": "API Base URL",
        "type": "string",
        "default": "https://api.minimax.chat/v1"
      },
      "apiKey": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true
      },
      "groupId": {
        "description": "GroupId（可选，作为 query 参数）",
        "type": "string",
        "default": ""
      },
      "model": {
        "description": "模型",
        "type": "string",
        "default": "speech-02-hd"
      },
      "voice": {
        "description": "voice_id",
        "type": "string",
        "default": "female-shaonv"
      },
      "format": {
        "description": "输出格式",
        "type": "string",
        "default": "mp3",
        "options": ["mp3", "wav", "opus", "flac", "aac", "pcm"]
      }
    }
  },
  "mimo": {
    "description": "小米 MiMo 语音合成",
    "type": "object",
    "hint": "MiMo 走 OpenAI 兼容的 /chat/completions + audio 参数；baseUrl 请按官方文档填写。",
    "items": {
      "baseUrl": {
        "description": "API Base URL（按 MiMo 官方文档填写）",
        "type": "string",
        "default": ""
      },
      "apiKey": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true
      },
      "model": {
        "description": "模型",
        "type": "string",
        "default": "mimo-v2.5-tts"
      },
      "voice": {
        "description": "音色 id",
        "type": "string",
        "default": ""
      },
      "style": {
        "description": "默认风格提示（情绪未命中时使用）",
        "type": "string",
        "default": ""
      },
      "format": {
        "description": "输出格式",
        "type": "string",
        "default": "wav",
        "options": ["wav", "mp3", "opus", "flac", "aac", "pcm"]
      }
    }
  },
  "openai": {
    "description": "OpenAI 兼容 /v1/audio/speech",
    "type": "object",
    "items": {
      "baseUrl": {
        "description": "API Base URL",
        "type": "string",
        "default": "https://api.openai.com/v1"
      },
      "apiKey": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true
      },
      "model": {
        "description": "模型",
        "type": "string",
        "default": "gpt-4o-mini-tts"
      },
      "voice": {
        "description": "音色",
        "type": "string",
        "default": "alloy"
      },
      "format": {
        "description": "输出格式",
        "type": "string",
        "default": "mp3",
        "options": ["mp3", "wav", "opus", "flac", "aac", "pcm"]
      },
      "emotionInstructions": {
        "description": "是否把情绪写成 instructions",
        "type": "bool",
        "default": true
      }
    }
  },
  "defaultVoice": {
    "description": "默认参考音色（本地提供商使用：音色库里的 id 或名称）",
    "type": "string",
    "default": "",
    "hint": "本地提供商留空时使用音色库第一个可用音色；在线提供商的 voice 请在各提供商配置里填。"
  },
  "defaultEmotion": {
    "description": "默认情绪模式",
    "type": "string",
    "default": "auto",
    "hint": "auto=内置词典自动判断；off=不加情绪；也可直接填 happy/angry/sad/fear/disgust/down/surprise/calm/neutral 或中文（开心/生气/…）。/朗读 -e 可临时覆盖。"
  },
  "emotionIntensity": {
    "description": "默认情绪强度",
    "type": "float",
    "default": 0.6,
    "slider": { "min": 0, "max": 1, "step": 0.05 }
  },
  "ttsSpeed": {
    "description": "默认语速倍率",
    "type": "float",
    "default": 1.0,
    "slider": { "min": 0.5, "max": 2, "step": 0.05 }
  },
  "voiceDir": {
    "description": "参考音色库目录",
    "type": "string",
    "default": "data/voices",
    "hint": "相对路径基于插件目录；元数据写在同级 <目录名>.json（默认 data/voices.json）。"
  },
  "workerUrl": {
    "description": "rvc-worker 地址（翻唱用）",
    "type": "string",
    "default": "http://127.0.0.1:7870"
  },
  "workerToken": {
    "description": "rvc-worker Bearer Token",
    "type": "string",
    "default": "",
    "secret": true
  },
  "workerModel": {
    "description": "RVC 模型（.pth 的 id 或文件名）",
    "type": "string",
    "default": "",
    "hint": "留空时调用 GET /v1/models 取第一个可用模型。"
  },
  "workerIndex": {
    "description": "RVC index 文件（可选）",
    "type": "string",
    "default": ""
  },
  "workerF0Method": {
    "description": "音高提取方法",
    "type": "string",
    "default": "rmvpe",
    "options": ["rmvpe", "pm", "harvest", "crepe", "fcpe"]
  },
  "workerKeyShift": {
    "description": "变调（半音）",
    "type": "int",
    "default": 0,
    "slider": { "min": -24, "max": 24, "step": 1 }
  },
  "allowedGroups": {
    "description": "允许使用语音命令的群号白名单（留空=不限制）",
    "type": "list",
    "default": [],
    "hint": "私聊不受限制。"
  },
  "maxTextLen": {
    "description": "单次朗读最长文本字数",
    "type": "int",
    "default": 1000,
    "slider": { "min": 50, "max": 5000, "step": 50 }
  },
  "maxDurationSec": {
    "description": "翻唱允许的最长歌曲时长（秒）",
    "type": "int",
    "default": 600,
    "slider": { "min": 30, "max": 3600, "step": 30 }
  },
  "jobTimeoutSec": {
    "description": "rvc-worker 单个任务最长等待秒数",
    "type": "int",
    "default": 1800,
    "slider": { "min": 120, "max": 7200, "step": 60 }
  },
  "requestTimeoutSec": {
    "description": "TTS 请求读取超时（秒）",
    "type": "int",
    "default": 600,
    "slider": { "min": 30, "max": 1800, "step": 30 }
  },
  "sendProgress": {
    "description": "翻唱时发送阶段提示",
    "type": "bool",
    "default": true
  }
}
